-- Побайтовое уточнение body_parse_automaton_ver_3.smv.
--
-- Один переход модели соответствует одному внешнему такту:
--   1. offered_byte предлагает автомату один байт либо NO_BYTE;
--   2. операционный слой op_event классифицирует наблюдение;
--   3. управляющий автомат меняет state;
--   4. регистры обновляются только на том же такте.
--
-- MAX_BODY и MAX_ARENA конечны только потому, что nuXmv строит конечную модель.
-- Это границы модели, а не предлагаемые ограничения Java-реализации.

MODULE main

CONSTANTS
  NO_BODY,
  FIXED_LENGTH_BODY,
  CHUNKED_BODY,
  NEED_MORE_DATA,
  CHUNK_SIZE_DIGIT_ACCEPTED,
  CHUNK_SIZE_OVERFLOW,
  ZERO_CHUNK_SIZE_TERMINATED,
  CHUNK_SIZE_TERMINATED,
  LF_ACCEPTED,
  CR_ACCEPTED,
  FIXED_BODY_BYTE_ACCEPTED,
  CHUNK_DATA_BYTE_ACCEPTED,
  INVALID_INPUT;

DEFINE
  MAX_BODY  := 15;
  MAX_ARENA := 15;

  -- Выход операционного слоя. Управляющий автомат не разбирает байт повторно.
  op_event := case
    state = INITIAL & body_mode = EMPTY                         : NO_BODY;
    state = INITIAL & body_mode = FIXED & declared_length = 0  : NO_BODY;
    state = INITIAL & body_mode = FIXED & declared_length > 0  : FIXED_LENGTH_BODY;
    state = INITIAL & body_mode = CHUNKED                       : CHUNKED_BODY;

    offered_byte = NO_BYTE                                  : NEED_MORE_DATA;

    state = READ_CHUNK_SIZE & offered_byte = HEX_DIGIT &
      chunk_size <= (MAX_BODY - hex_value) / 16              : CHUNK_SIZE_DIGIT_ACCEPTED;
    state = READ_CHUNK_SIZE & offered_byte = HEX_DIGIT       : CHUNK_SIZE_OVERFLOW;
    state = READ_CHUNK_SIZE & offered_byte = CR &
      chunk_size = 0                                        : ZERO_CHUNK_SIZE_TERMINATED;
    state = READ_CHUNK_SIZE & offered_byte = CR &
      chunk_size > 0                                        : CHUNK_SIZE_TERMINATED;

    state = EXPECT_CHUNK_LF & offered_byte = LF             : LF_ACCEPTED;
    state = EXPECT_CHUNK_CR & offered_byte = CR             : CR_ACCEPTED;
    state = EXPECT_FINAL_CR & offered_byte = CR             : CR_ACCEPTED;
    state = EXPECT_FINAL_LF & offered_byte = LF             : LF_ACCEPTED;

    state = READ_FIXED_BODY                                 : FIXED_BODY_BYTE_ACCEPTED;
    state = READ_CHUNK_DATA                                 : CHUNK_DATA_BYTE_ACCEPTED;
    TRUE                                                    : INVALID_INPUT;
  esac;

-- Переменные окружения намеренно не имеют ASSIGN: nuXmv свободно выбирает
-- их значение на каждом такте. VAR, а не IVAR, позволяет ссылаться на них
-- в CTL-свойствах перехода.
VAR
  -- INITIAL читает результат первого автомата; после INITIAL значение несущественно.
  body_mode       : {EMPTY, FIXED, CHUNKED};
  declared_length : 0..MAX_BODY;

  -- Абстракция входного октета. В состояниях чтения тела любой вариант,
  -- кроме NO_BYTE, является байтом данных, в том числе CR, LF и HEX_DIGIT.
  offered_byte : {NO_BYTE, HEX_DIGIT, CR, LF, DATA};
  hex_value    : 0..15;

VAR
  state : {
    INITIAL,
    READ_CHUNK_SIZE,
    EXPECT_CHUNK_LF,
    EXPECT_FINAL_CR,
    EXPECT_FINAL_LF,
    READ_FIXED_BODY,
    READ_CHUNK_DATA,
    EXPECT_CHUNK_CR,
    SUCCESS,
    ERROR
  };

  delimiter_context : {NO_DELIMITER, AFTER_SIZE, AFTER_DATA, AFTER_ZERO};

  chunk_size : 0..MAX_BODY;
  remaining  : 0..MAX_BODY;
  arena_ptr  : 0..MAX_ARENA;

  -- Наблюдатели нужны только для проверки отношения между соседними тактами.
  previous_remaining : 0..MAX_BODY;
  body_byte_consumed : boolean;

ASSIGN
  init(state)             := INITIAL;
  init(delimiter_context) := NO_DELIMITER;
  init(chunk_size)        := 0;
  init(remaining)         := 0;
  init(arena_ptr)         := 0;
  init(previous_remaining) := 0;
  init(body_byte_consumed) := FALSE;

  next(state) := case
    state = SUCCESS : SUCCESS;
    state = ERROR   : ERROR;

    state = INITIAL & op_event = NO_BODY           : SUCCESS;
    state = INITIAL & op_event = FIXED_LENGTH_BODY : READ_FIXED_BODY;
    state = INITIAL & op_event = CHUNKED_BODY      : READ_CHUNK_SIZE;

    op_event = NEED_MORE_DATA : state;

    state = READ_CHUNK_SIZE & op_event = CHUNK_SIZE_DIGIT_ACCEPTED : READ_CHUNK_SIZE;
    state = READ_CHUNK_SIZE & op_event = CHUNK_SIZE_OVERFLOW       : ERROR;
    state = READ_CHUNK_SIZE & op_event = ZERO_CHUNK_SIZE_TERMINATED : EXPECT_CHUNK_LF;
    state = READ_CHUNK_SIZE & op_event = CHUNK_SIZE_TERMINATED      : EXPECT_CHUNK_LF;

    state = EXPECT_CHUNK_LF & op_event = LF_ACCEPTED &
      delimiter_context = AFTER_SIZE : READ_CHUNK_DATA;
    state = EXPECT_CHUNK_LF & op_event = LF_ACCEPTED &
      delimiter_context = AFTER_DATA : READ_CHUNK_SIZE;
    state = EXPECT_CHUNK_LF & op_event = LF_ACCEPTED &
      delimiter_context = AFTER_ZERO : EXPECT_FINAL_CR;

    state = EXPECT_FINAL_CR & op_event = CR_ACCEPTED : EXPECT_FINAL_LF;
    state = EXPECT_FINAL_LF & op_event = LF_ACCEPTED : SUCCESS;

    state = READ_FIXED_BODY & op_event = FIXED_BODY_BYTE_ACCEPTED & remaining > 1
      : READ_FIXED_BODY;
    state = READ_FIXED_BODY & op_event = FIXED_BODY_BYTE_ACCEPTED & remaining = 1
      : SUCCESS;

    state = READ_CHUNK_DATA & op_event = CHUNK_DATA_BYTE_ACCEPTED & remaining > 1
      : READ_CHUNK_DATA;
    state = READ_CHUNK_DATA & op_event = CHUNK_DATA_BYTE_ACCEPTED & remaining = 1
      : EXPECT_CHUNK_CR;

    state = EXPECT_CHUNK_CR & op_event = CR_ACCEPTED : EXPECT_CHUNK_LF;

    TRUE : ERROR;
  esac;

  next(delimiter_context) := case
    state = READ_CHUNK_SIZE & op_event = ZERO_CHUNK_SIZE_TERMINATED
      : AFTER_ZERO;
    state = READ_CHUNK_SIZE & op_event = CHUNK_SIZE_TERMINATED
      : AFTER_SIZE;
    state = EXPECT_CHUNK_CR & op_event = CR_ACCEPTED
      : AFTER_DATA;
    state = EXPECT_CHUNK_LF & op_event = LF_ACCEPTED
      : NO_DELIMITER;
    TRUE : delimiter_context;
  esac;

  next(chunk_size) := case
    state = READ_CHUNK_SIZE & op_event = CHUNK_SIZE_DIGIT_ACCEPTED
      : chunk_size * 16 + hex_value;
    state = EXPECT_CHUNK_LF & op_event = LF_ACCEPTED &
      delimiter_context = AFTER_SIZE
      : 0;
    TRUE : chunk_size;
  esac;

  next(remaining) := case
    state = INITIAL & op_event = FIXED_LENGTH_BODY
      : declared_length;
    state = EXPECT_CHUNK_LF & op_event = LF_ACCEPTED &
      delimiter_context = AFTER_SIZE
      : chunk_size;
    state = READ_FIXED_BODY & op_event = FIXED_BODY_BYTE_ACCEPTED & remaining > 0
      : remaining - 1;
    state = READ_CHUNK_DATA & op_event = CHUNK_DATA_BYTE_ACCEPTED & remaining > 0
      : remaining - 1;
    TRUE : remaining;
  esac;

  next(arena_ptr) := case
    (state = READ_FIXED_BODY & op_event = FIXED_BODY_BYTE_ACCEPTED |
     state = READ_CHUNK_DATA & op_event = CHUNK_DATA_BYTE_ACCEPTED) &
      remaining > 0 &
      arena_ptr < MAX_ARENA
      : arena_ptr + 1;
    TRUE : arena_ptr;
  esac;

  next(previous_remaining) := remaining;
  next(body_byte_consumed) :=
    (state = READ_FIXED_BODY & op_event = FIXED_BODY_BYTE_ACCEPTED |
     state = READ_CHUNK_DATA & op_event = CHUNK_DATA_BYTE_ACCEPTED) &
    remaining > 0;

------------------------------------------------------------------
-- Инварианты безопасности
------------------------------------------------------------------

-- Отсутствие входного байта не меняет управляющее состояние.
LTLSPEC G (state != INITIAL & state != SUCCESS & state != ERROR &
           offered_byte = NO_BYTE -> X(state) = state)

-- Счётчик уменьшается ровно на один только при принятии байта тела.
SPEC AG (body_byte_consumed -> remaining = previous_remaining - 1)

-- Разделители чанков не попадают в арену.
LTLSPEC G ((state = READ_CHUNK_SIZE | state = EXPECT_CHUNK_CR |
            state = EXPECT_CHUNK_LF | state = EXPECT_FINAL_CR |
            state = EXPECT_FINAL_LF) -> X(arena_ptr) = arena_ptr)

-- Завершённый автомат терминален.
SPEC AG (state = SUCCESS -> AX state = SUCCESS)
SPEC AG (state = ERROR -> AX state = ERROR)

-- После последнего байта fixed-length тела наступает SUCCESS.
LTLSPEC G (state = READ_FIXED_BODY & remaining = 1 &
           offered_byte != NO_BYTE -> X(state) = SUCCESS)

-- После последнего байта чанка ожидается его CRLF.
LTLSPEC G (state = READ_CHUNK_DATA & remaining = 1 &
           offered_byte != NO_BYTE -> X(state) = EXPECT_CHUNK_CR)

-- После нулевого чанка автомат полностью поглощает обязательный финальный CRLF.
LTLSPEC G (state = READ_CHUNK_SIZE & offered_byte = CR & chunk_size = 0 ->
           X(state) = EXPECT_CHUNK_LF & X(delimiter_context) = AFTER_ZERO)
LTLSPEC G (state = EXPECT_CHUNK_LF & delimiter_context = AFTER_ZERO &
           offered_byte = LF -> X(state) = EXPECT_FINAL_CR)
LTLSPEC G (state = EXPECT_FINAL_CR & offered_byte = CR ->
           X(state) = EXPECT_FINAL_LF)
LTLSPEC G (state = EXPECT_FINAL_LF & offered_byte = LF ->
           X(state) = SUCCESS)

------------------------------------------------------------------
-- Свидетели достижимости: nuXmv должен найти контрпример к каждому !EF.
------------------------------------------------------------------

SPEC !EF (state = READ_FIXED_BODY)
SPEC !EF (state = READ_CHUNK_DATA)
SPEC !EF (state = EXPECT_FINAL_CR)
SPEC !EF (state = EXPECT_FINAL_LF)
SPEC !EF (state = ERROR)
